{
  "version": 2,
  "routes": [
    {
      "src": "/api/login",
      "dest": "index.js",
      "methods": ["POST"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "index.js",
      "continue": true
    }
  ],
  "protectionBypass": {
    "/api/login": {
      "bypass": true
    }
  }
}